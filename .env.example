# Portas expostas no host (copie para .env na raiz do projeto)
NGINX_PORT=8080
WEB_PORT=3000
DB_FORWARD_PORT=3307
REDIS_FORWARD_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DB_ROOT_PASSWORD=root
DB_DATABASE=minha_rotina
DB_USERNAME=minha_rotina
DB_PASSWORD=secret

# WSL / bind mounts: use true se o hot reload não detectar mudanças
CHOKIDAR_USEPOLLING=false

# Web Push (VAPID) — gere um par com: docker compose exec api php artisan rotina:vapid-keys
VAPID_SUBJECT=mailto:contato@minha-rotina.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
